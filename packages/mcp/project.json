{
  "name": "mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/mcp/src",
  "projectType": "application",
  "tags": ["type:app"],
  "implicitDependencies": [
    "app",
    "core",
    "generators",
    "packager",
    "reverse",
    "validators"
  ],
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx packages/mcp/src/index.ts" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p packages/mcp/tsconfig.json" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run packages/mcp" }
    }
  }
}
