# HTTP port for the server (default: 3000)
PORT=3000

# Per-IP request budget for /api/generate and /api/preview in a 60s window.
# Set to 0 to disable rate limiting (default: 120)
RATE_LIMIT_PER_MIN=120

# Default sandbox driver: auto | temp-dir | bwrap | podman | docker | firejail | systemd-run
SANDBOX=auto

# Optional web search. Without a key the keyless DuckDuckGo fallback is used.
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# Reverse endpoint hardening (see README: /api/reverse guvenlik sinirlari).
# HOST defaults to loopback because the endpoint is unauthenticated.
HOST=127.0.0.1
# Colon separated directories /api/reverse may read. Unset = any readable path.
# REVERSE_ROOTS=/srv/apps:/home/me/src
REVERSE_CONCURRENCY=2
REVERSE_QUEUE_TIMEOUT_MS=30000
REVERSE_TIMEOUT_MS=120000
